<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/computerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/default_computer" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/openHistory" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/history" android:padding="12dp" android:src="@drawable/icon_history" />
        <ImageButton android:id="@+id/openComputers" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/computers" android:padding="12dp" android:src="@drawable/icon_computer" />
        <ImageButton android:id="@+id/toggleDim" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/extra_dim" android:padding="12dp" android:src="@drawable/icon_dim" />
        <ImageButton android:id="@+id/changeLanguage" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/language" android:padding="12dp" android:src="@drawable/icon_language" />
        <ImageButton android:id="@+id/openSettings" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/settings" android:padding="12dp" android:src="@drawable/icon_settings" />
    </LinearLayout>
    <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="20dp" android:layout_weight="1" android:background="@null" android:gravity="top|start" android:hint="@string/input_hint" android:imeOptions="flagNoExtractUi" android:importantForAutofill="no" android:inputType="textCapSentences|textMultiLine" android:padding="0dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textCursorDrawable="@null" android:textSize="18sp" />
    <HorizontalScrollView android:id="@+id/computerChooserScroll" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:fillViewport="false" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:id="@+id/computerChooser" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
    </HorizontalScrollView>
    <TextView android:id="@+id/syncStatus" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <Button android:id="@+id/pair" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/button_secondary" android:text="@string/pair_computer" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="16sp" />
    <LinearLayout android:id="@+id/primaryActions" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/openImage" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:background="@drawable/button_secondary" android:contentDescription="@string/image" android:padding="12dp" android:src="@drawable/icon_image" />
        <Button android:id="@+id/sync" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:background="@drawable/button_secondary" android:text="@string/sync" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="15sp" />
        <Button android:id="@+id/newSession" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/button_primary" android:text="@string/new_session" android:textAllCaps="false" android:textColor="@color/button_primary_text" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
