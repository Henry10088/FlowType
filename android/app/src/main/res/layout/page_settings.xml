<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="8dp"><ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" android:padding="12dp" android:src="@drawable/icon_back" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/computers" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
        <Switch android:id="@+id/autoSelectComputer" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/auto_select_computer" android:textColor="@color/text_primary" android:textSize="16sp" />
        <TextView android:id="@+id/autoSelectSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp" android:text="@string/auto_select_summary" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/divider" />
        <Switch android:id="@+id/keepScreenOn" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/keep_screen_on" android:textColor="@color/text_primary" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="20dp" android:text="@string/keep_screen_on_summary" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
        <Switch android:id="@+id/extraDim" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/extra_dim" android:textColor="@color/text_primary" android:textSize="16sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/divider" />
        <Switch android:id="@+id/floatingInput" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/floating_input" android:textColor="@color/text_primary" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="20dp" android:text="@string/floating_input_summary" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/version_label" android:textColor="@color/text_secondary" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
